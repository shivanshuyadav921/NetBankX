# Copy these values into Vercel Project Settings; do not commit real secrets.
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=https://your-project.vercel.app
JWT_SECRET=generate-a-32-byte-or-longer-random-secret
JWT_EXPIRES_IN=24h
DATABASE_URL=mysql://username:password@host:3306/netbankx_db
DB_SSL=true
DB_USE_EMBEDDED_FALLBACK=false
DB_CONNECTION_LIMIT=10
