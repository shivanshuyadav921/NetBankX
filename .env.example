# ==============================================================================
# NETBANKX � Environment Variables Template (Development / Preview / Production)
# ==============================================================================
# IMPORTANT: Never commit actual credentials or private keys to source control.

#
# LOCAL DEVELOPMENT: Copy this file to .env and fill in values.
# In local dev, if DATABASE_URL is blank, the embedded in-memory store is
# used automatically. You do NOT need a running MySQL instance locally.
#
# PRODUCTION: CORS_ORIGIN must be your exact Vercel domain (NOT *).
# The backend validates this at startup and will refuse to start if it is *.

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME (Server-Only)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=https://your-project-name.vercel.app

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY SECRETS (Server-Only � Critical)
# ------------------------------------------------------------------------------
# Provide a cryptographically random 256-bit secret for signing JSON Web Tokens:
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_random_string_2026
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 3. REMOTE MYSQL DATABASE CONFIGURATION (Server-Only)
# ------------------------------------------------------------------------------
# Option A: Unified Connection URI (Recommended for PlanetScale, AWS RDS, Aiven, Railway, TiDB)
DATABASE_URL=mysql://username:password@host.provider.com:3306/netbankx_db?ssl={"rejectUnauthorized":true}

# Option B: Discrete Parameters (Alternative)
DB_HOST=your-mysql-host.provider.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=netbankx_db
DB_CONNECTION_LIMIT=10
DB_SSL=true

# Set to "false" in Production to strictly mandate the remote MySQL database connection.
# Set to "true" in Local Development / CI if running in zero-setup in-memory fallback mode.
DB_USE_EMBEDDED_FALLBACK=false

# ------------------------------------------------------------------------------
# 4. NETWORK SIMULATION ENGINE TUNING (Server-Only)
# ------------------------------------------------------------------------------
SIM_DEFAULT_LOSS_RATE=0.02
SIM_DEFAULT_BASE_LATENCY=15
SIM_TICK_RATE_MS=50

